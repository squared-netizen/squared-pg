{
  "format": "squared-cartridge",
  "format_version": 3,
  "kind": "template",
  "id": "template.template",
  "version": "0.1.0",
  "tree": "tree/",
  "title": "Template",
  "description": "Makes a template of your own: a cartridge that sqpg makes workspaces from, and that New in sqIDE lists once installed. It starts as a C++ terminal program; change it into anything.",
  "requires_features": [],
  "license": "MIT",
  "authors": [
    {
      "name": "squared-pg maintainers"
    }
  ],
  "consumers": {
    "squared_pg": {
      "project_types": [
        "cartridge"
      ],
      "platforms": [
        "all"
      ],
      "working_directory": "cartridge",
      "processor": "substitute",
      "layers": {
        "application": [
          "cartridge"
        ],
        "build": [
          "build.lua",
          "sq/build"
        ]
      },
      "integration_areas": [],
      "integration_arity": {},
      "parameters": [
        {
          "name": "project_name",
          "type": "identifier",
          "required": true,
          "description": "The template's short name: game makes template.game."
        },
        {
          "name": "title",
          "type": "string",
          "required": false,
          "default_from": "project_name",
          "description": "What New shows as the template's name."
        },
        {
          "name": "description",
          "type": "string",
          "required": false,
          "default": "A template of my own.",
          "description": "One line: what it is, for its manifest and README."
        }
      ],
      "requires": {
        "packages": [],
        "kits": {
          "required": [],
          "optional": []
        },
        "engine": ">=0.1.0 <0.2.0",
        "capabilities": [
          "capability.template.substitute@^1.0",
          "capability.project.plan@^1.0"
        ]
      },
      "ownership": {
        "generated": [
          "sq/build/cartridge.lua",
          ".gitignore"
        ],
        "user": [],
        "shared": [],
        "default": "user"
      }
    },
    "square": {
      "roles": {
        "cartridge": "cartridge",
        "template": "cartridge/tree",
        "build": "build",
        "dist": "dist"
      }
    }
  }
}
