{
  "format": "squared-cartridge",
  "format_version": 3,
  "kind": "template",
  "id": "template.package",
  "version": "0.1.0",
  "tree": "tree/",
  "title": "Package",
  "description": "Makes a package: a cartridge of reusable squared code, a C++ module and its part of the build, that a workspace takes in as source. sqmake packs it, sqmake install makes it usable.",
  "requires_features": [],
  "license": "MIT",
  "authors": [
    {
      "name": "squared-pg maintainers"
    }
  ],
  "consumers": {
    "squared_pg": {
      "project_types": [
        "cartridge"
      ],
      "platforms": [
        "all"
      ],
      "working_directory": "cartridge",
      "processor": "substitute",
      "layers": {
        "application": [
          "cartridge"
        ],
        "build": [
          "build.lua",
          "sq/build"
        ]
      },
      "integration_areas": [],
      "integration_arity": {},
      "parameters": [
        {
          "name": "project_name",
          "type": "identifier",
          "required": true,
          "description": "The package's short name: shapes makes package.shapes, module shapes."
        },
        {
          "name": "description",
          "type": "string",
          "required": false,
          "default": "A Squared package.",
          "description": "One line: what it is, for its manifest and README."
        }
      ],
      "requires": {
        "packages": [],
        "kits": {
          "required": [],
          "optional": []
        },
        "engine": ">=0.1.0 <0.2.0",
        "capabilities": [
          "capability.template.substitute@^1.0",
          "capability.project.plan@^1.0"
        ]
      },
      "ownership": {
        "generated": [
          "sq/build/cartridge.lua",
          ".gitignore"
        ],
        "user": [],
        "shared": [],
        "default": "user"
      }
    },
    "square": {
      "roles": {
        "cartridge": "cartridge",
        "package": "cartridge/tree",
        "build": "build",
        "dist": "dist"
      }
    }
  }
}
