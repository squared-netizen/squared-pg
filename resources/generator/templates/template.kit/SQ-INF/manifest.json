{
  "format": "squared-cartridge",
  "format_version": 3,
  "kind": "template",
  "id": "template.kit",
  "version": "0.2.0",
  "tree": "tree/",
  "title": "Kit",
  "description": "Makes a kit: a cartridge that bridges something outside squared into a workspace. It adds a C++ module and its part of the build; sqmake packs it, sqmake install makes it usable.",
  "requires_features": [],
  "license": "MIT",
  "authors": [
    {
      "name": "squared-pg maintainers"
    }
  ],
  "consumers": {
    "squared_pg": {
      "project_types": [
        "cartridge"
      ],
      "platforms": [
        "all"
      ],
      "working_directory": "cartridge",
      "processor": "substitute",
      "layers": {
        "application": [
          "cartridge"
        ],
        "build": [
          "build.lua",
          "sq/build"
        ]
      },
      "integration_areas": [],
      "integration_arity": {},
      "parameters": [
        {
          "name": "project_name",
          "type": "identifier",
          "required": true,
          "description": "The kit's short name: fmt makes kit.fmt, module fmt."
        },
        {
          "name": "external_id",
          "type": "string",
          "required": false,
          "default": "",
          "description": "What the kit wraps, if anything. Empty for a kit that adds only files."
        },
        {
          "name": "runtime_model",
          "type": "enum",
          "required": false,
          "default": "none",
          "description": "none, polled or callback. See Generator Architecture 2.9.2."
        },
        {
          "name": "description",
          "type": "string",
          "required": false,
          "default": "A Squared kit.",
          "description": "One line: what it is, for its manifest and README."
        }
      ],
      "requires": {
        "packages": [],
        "kits": {
          "required": [],
          "optional": []
        },
        "engine": ">=0.1.0 <0.2.0",
        "capabilities": [
          "capability.template.substitute@^1.0",
          "capability.project.plan@^1.0"
        ]
      },
      "ownership": {
        "generated": [
          "sq/build/cartridge.lua",
          ".gitignore"
        ],
        "user": [],
        "shared": [],
        "default": "user"
      }
    },
    "square": {
      "roles": {
        "cartridge": "cartridge",
        "kit": "cartridge/tree",
        "build": "build",
        "dist": "dist"
      }
    }
  }
}
