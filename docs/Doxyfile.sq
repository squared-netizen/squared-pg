PROJECT_NAME           = "Squared SQ Core"
PROJECT_NUMBER         = "0 development"
OUTPUT_DIRECTORY       = build/generated-sq-doxygen
INPUT                  = include/squared/sq
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
SOURCE_BROWSER         = YES
STRIP_FROM_INC_PATH    = include
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
GENERATE_TREEVIEW      = YES
