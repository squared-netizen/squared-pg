{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://squared.invalid/schema/sq-manifest-2.schema.json",
  "title": "Squared Cartridge manifest envelope, format version 2",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "kind",
    "id",
    "version",
    "tree"
  ],
  "properties": {
    "format": {
      "const": "squared-cartridge"
    },
    "format_version": {
      "const": 2
    },
    "kind": {
      "description": "Opaque role token. This schema deliberately does not enumerate legal values: the set of roles belongs to the ecosystem, not to the container format (see 0.1).",
      "$ref": "#/$defs/identitySegment"
    },
    "id": {
      "$ref": "#/$defs/identity"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "tree": {
      "$ref": "#/$defs/treeRoot"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "requires_features": {
      "description": "Container capabilities this cartridge needs from a READER -- a compression method, a signature scheme. Guards the reader and fails at open. Requirements on a consumer belong in that consumer section (5.6), not here.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]*$"
      }
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "license": {
      "type": "string"
    },
    "presentation": {
      "type": "object",
      "properties": {
        "thumbnail": {
          "$ref": "#/$defs/entryPath"
        },
        "icon": {
          "$ref": "#/$defs/entryPath"
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "generator": {
          "$ref": "#/$defs/compatRef"
        },
        "template": {
          "type": "string"
        },
        "kits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "framework": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "consumers": {
      "description": "Sections addressed to consuming tools, keyed by consumer identity. Each value is an object whose contents this schema does not constrain and a conforming reader does not interpret.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/consumerId"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-.]+)?(\\+[0-9A-Za-z-.]+)?$"
    },
    "range": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ]
    },
    "entryPath": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\u0000-\\u001f\\\\:]+$"
    },
    "treeRoot": {
      "description": "Payload root relative to the cartridge root. Either \".\" or a relative directory path ending in \"/\", with no \".\" or \"..\" components, not under SQ-INF/.",
      "type": "string",
      "maxLength": 1024,
      "oneOf": [
        {
          "const": "."
        },
        {
          "pattern": "^(?!/)(?!SQ-INF/)(?!.*(^|/)\\.\\.?(/|$))(?!.*//)[^\\u0000-\\u001f\\\\:]+/$"
        }
      ]
    },
    "identitySegment": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64
    },
    "consumerId": {
      "description": "Dotted identity of a consuming tool, e.g. squared_pg.",
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    }
  }
}
