{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://squared.invalid/schema/sq-manifest-1.schema.json",
  "title": "Squared Cartridge Manifest, format_version 1",

  "type": "object",
  "required": ["format", "format_version", "kind", "id", "version"],

  "properties": {
    "format": { "const": "squared-cartridge" },
    "format_version": { "const": 1 },
    "kind": {
      "enum": ["cartridge", "template", "kit", "package", "asset-bundle", "plugin"]
    },
    "id": { "$ref": "#/$defs/identity" },
    "version": { "$ref": "#/$defs/semver" },
    "title": { "type": "string", "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "engine": { "$ref": "#/$defs/compatRef" },
    "requires_features": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" }
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "license": { "type": "string" },
    "presentation": {
      "type": "object",
      "properties": {
        "thumbnail": { "$ref": "#/$defs/entryPath" },
        "icon": { "$ref": "#/$defs/entryPath" }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "generator": { "$ref": "#/$defs/compatRef" },
        "template": { "type": "string" },
        "kits": { "type": "array", "items": { "type": "string" } },
        "packages": { "type": "array", "items": { "type": "string" } },
        "framework": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },

    "cartridge": { "$ref": "#/$defs/cartridgeBody" },
    "template": { "$ref": "#/$defs/templateBody" },
    "kit": { "$ref": "#/$defs/kitBody" },
    "package": { "$ref": "#/$defs/packageBody" },
    "assets": { "$ref": "#/$defs/assetsBody" },
    "plugin": { "$ref": "#/$defs/pluginBody" }
  },

  "allOf": [
    { "if": { "properties": { "kind": { "const": "cartridge" } } },
      "then": { "required": ["cartridge"],
                "not": { "anyOf": [
                  { "required": ["template"] }, { "required": ["kit"] },
                  { "required": ["package"] },  { "required": ["assets"] },
                  { "required": ["plugin"] } ] } } },

    { "if": { "properties": { "kind": { "const": "template" } } },
      "then": { "required": ["template"],
                "not": { "anyOf": [
                  { "required": ["cartridge"] }, { "required": ["kit"] },
                  { "required": ["package"] },   { "required": ["assets"] },
                  { "required": ["plugin"] } ] } } },

    { "if": { "properties": { "kind": { "const": "kit" } } },
      "then": { "required": ["kit"],
                "not": { "anyOf": [
                  { "required": ["cartridge"] }, { "required": ["template"] },
                  { "required": ["package"] },   { "required": ["assets"] },
                  { "required": ["plugin"] } ] } } },

    { "if": { "properties": { "kind": { "const": "package" } } },
      "then": { "required": ["package"],
                "not": { "anyOf": [
                  { "required": ["cartridge"] }, { "required": ["template"] },
                  { "required": ["kit"] },       { "required": ["assets"] },
                  { "required": ["plugin"] } ] } } },

    { "if": { "properties": { "kind": { "const": "asset-bundle" } } },
      "then": { "required": ["assets"],
                "not": { "anyOf": [
                  { "required": ["cartridge"] }, { "required": ["template"] },
                  { "required": ["kit"] },       { "required": ["package"] },
                  { "required": ["plugin"] } ] } } },

    { "if": { "properties": { "kind": { "const": "plugin" } } },
      "then": { "required": ["plugin"],
                "not": { "anyOf": [
                  { "required": ["cartridge"] }, { "required": ["template"] },
                  { "required": ["kit"] },       { "required": ["package"] },
                  { "required": ["assets"] } ] } } }
  ],

  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-.]+)?(\\+[0-9A-Za-z-.]+)?$"
    },
    "range": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      ]
    },
    "entryPath": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\u0000-\\u001f\\\\:]+$"
    },
    "glob": { "type": "string", "maxLength": 1024 },
    "compatRef": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "version": { "$ref": "#/$defs/range" }
      }
    },
    "platforms": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
    },
    "requiresBlock": {
      "type": "object",
      "properties": {
        "framework": { "$ref": "#/$defs/range" },
        "packages": { "type": "array", "items": { "type": "string" } },
        "kits": { "type": "array", "items": { "type": "string" } },
        "engine_capabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ownership": {
      "type": "object",
      "properties": {
        "generated": { "type": "array", "items": { "$ref": "#/$defs/glob" } },
        "user": { "type": "array", "items": { "$ref": "#/$defs/glob" } },
        "shared": { "type": "array", "items": { "$ref": "#/$defs/glob" } }
      }
    },
    "luaEntry": {
      "type": "object",
      "required": ["module", "type", "lua_abi"],
      "properties": {
        "module": { "$ref": "#/$defs/entryPath" },
        "type": { "enum": ["lua-source", "lua-bytecode"] },
        "lua_abi": { "type": "string", "pattern": "^lua[0-9]{2}$" },
        "target": { "type": "string", "pattern": "^[a-z0-9_]+-[a-z0-9_]+$" },
        "bytecode_cache": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/entryPath" }
        }
      }
    },

    "cartridgeBody": {
      "type": "object",
      "required": ["entry", "permissions"],
      "properties": {
        "entry": { "$ref": "#/$defs/luaEntry" },
        "framework": { "$ref": "#/$defs/compatRef" },
        "packages": { "type": "array", "items": { "type": "string" } },
        "display": {
          "type": "object",
          "properties": {
            "orientation": { "enum": ["landscape", "portrait", "any"] }
          }
        },
        "permissions": { "type": "array", "items": { "type": "string" } }
      }
    },

    "templateBody": {
      "type": "object",
      "required": ["tree", "platforms", "ownership"],
      "properties": {
        "project_types": { "type": "array", "items": { "type": "string" } },
        "platforms": { "$ref": "#/$defs/platforms" },
        "tree": { "$ref": "#/$defs/entryPath" },
        "processing": {
          "type": "object",
          "properties": {
            "engine": { "type": "string" },
            "delimiters": {
              "type": "array", "items": { "type": "string" },
              "minItems": 2, "maxItems": 2
            }
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "required"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "type": { "enum": ["string", "integer", "boolean", "enum"] },
              "required": { "type": "boolean" },
              "default": {},
              "pattern": { "type": "string" },
              "values": { "type": "array" },
              "description": { "type": "string" }
            }
          }
        },
        "requires": {
          "allOf": [{ "$ref": "#/$defs/requiresBlock" }],
          "properties": {
            "kits": {
              "type": "object",
              "properties": {
                "required": { "type": "array", "items": { "type": "string" } },
                "optional": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "ownership": { "$ref": "#/$defs/ownership" }
      }
    },

    "kitBody": {
      "type": "object",
      "required": ["external", "platforms", "integration_areas"],
      "properties": {
        "external": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" },
            "version": { "$ref": "#/$defs/range" }
          }
        },
        "provides": { "type": "array", "items": { "type": "string" } },
        "platforms": { "$ref": "#/$defs/platforms" },
        "compatible_templates": { "type": "array", "items": { "type": "string" } },
        "requires": { "$ref": "#/$defs/requiresBlock" },
        "integration_areas": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" }
        },
        "ownership": { "$ref": "#/$defs/ownership" }
      }
    },

    "packageBody": {
      "type": "object",
      "required": ["platforms"],
      "properties": {
        "provides": { "type": "array", "items": { "type": "string" } },
        "platforms": { "$ref": "#/$defs/platforms" },
        "requires": { "$ref": "#/$defs/requiresBlock" },
        "layout": {
          "type": "object",
          "properties": {
            "include": { "$ref": "#/$defs/entryPath" },
            "src": { "$ref": "#/$defs/entryPath" },
            "build": { "$ref": "#/$defs/entryPath" }
          }
        },
        "build": {
          "type": "object",
          "properties": {
            "system": { "enum": ["cmake", "gradle", "none"] },
            "targets": { "type": "array", "items": { "type": "string" } }
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["default"],
            "properties": {
              "default": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },

    "assetsBody": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "requires": { "$ref": "#/$defs/requiresBlock" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "path", "type"],
            "properties": {
              "id": { "$ref": "#/$defs/identity" },
              "path": { "$ref": "#/$defs/entryPath" },
              "type": { "type": "string" },
              "format": { "type": "string" },
              "platforms": { "$ref": "#/$defs/platforms" },
              "version": { "$ref": "#/$defs/semver" }
            }
          }
        }
      }
    },

    "pluginBody": {
      "type": "object",
      "required": ["extends", "api_version", "entry"],
      "properties": {
        "extends": { "const": "squared-pg" },
        "api_version": { "type": "integer", "minimum": 1 },
        "entry": { "$ref": "#/$defs/entryPath" },
        "provides_services": { "type": "array", "items": { "type": "string" } },
        "requires": { "$ref": "#/$defs/requiresBlock" }
      }
    }
  }
}
