{
  "format": "squared-cartridge",
  "format_version": 2,
  "kind": "kit",
  "id": "kit.testcart",
  "version": "1.0.0",
  "tree": ".",
  "title": "Testcart Integration Kit",
  "description": "Minimal conforming kit fixture for the sqcart reader, writer and CLI round-trip tests.",
  "requires_features": [],
  "license": "MIT",
  "authors": [
    {
      "name": "sqcart maintainers"
    }
  ],
  "presentation": {
